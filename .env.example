# Connessione al database Postgres (su Railway viene generata automaticamente
# come DATABASE_URL quando aggiungi il plugin "PostgreSQL" al progetto)
DATABASE_URL="postgresql://user:password@localhost:5432/psico_gestionale"

# Credenziali di accesso all'unico account dell'app (la psicologa).
ADMIN_EMAIL="tuo-indirizzo@esempio.it"
ADMIN_PASSWORD="scegli-una-password-robusta"

# Chiave segreta usata per firmare il cookie di sessione: una stringa lunga e casuale.
# Genera con: openssl rand -hex 32
SESSION_SECRET=""

# Credenziali Gmail per l'invio delle fatture via email (usare una "Password per le app"
# generata su https://myaccount.google.com/apppasswords, NON la password normale di Gmail)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Nome/indirizzo che compare come mittente nelle email inviate ai pazienti
MAIL_FROM_NAME="Studio di Psicologia"
