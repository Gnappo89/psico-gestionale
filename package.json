{
  "name": "psico-gestionale",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma db push --skip-generate --accept-data-loss && next start -p $PORT",
    "postinstall": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "next": "14.2.15",
    "nodemailer": "6.9.15",
    "pdf-lib": "1.17.1",
    "prisma": "5.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.3.0",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/nodemailer": "6.4.16",
    "@types/react": "18.3.10",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
