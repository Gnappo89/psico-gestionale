generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Anagrafica pazienti
model Patient {
  id             String   @id @default(cuid())
  nome           String
  cognome        String
  codiceFiscale  String?
  email          String?
  telefono       String?
  indirizzo      String?
  tariffaSeduta  Decimal  @db.Decimal(10, 2)
  note           String?
  attivo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]

  @@index([cognome, nome])
}

// Fatture emesse ai pazienti
model Invoice {
  id             String    @id @default(cuid())
  numero         String    @unique
  anno           Int
  progressivo    Int
  data           DateTime  @default(now())
  descrizione    String
  importo        Decimal   @db.Decimal(10, 2)
  pagata         Boolean   @default(false)
  dataPagamento  DateTime?
  metodoPagamento String?
  inviataEmail   Boolean   @default(false)
  dataInvioEmail DateTime?
  note           String?

  // Conservazione digitale a norma (es. InfoCert LegalDoc): una fattura
  // pagata viene proposta per l'invio in conservazione. identificativoConservazione
  // e' il riferimento restituito dal sistema di conservazione (IPdA) una volta
  // che il documento e' stato acquisito definitivamente.
  statoConservazione     StatoConservazione @default(NON_INVIATA)
  dataInvioConservazione DateTime?
  identificativoConservazione String?
  erroreConservazione    String?

  // Fatture "storiche" importate da altri gestionali (PDF con grafica propria),
  // caricate solo a fini statistici: non generano un nuovo PDF dal template
  // dell'app e non vengono proposte per l'invio via email. pdfOriginale
  // conserva il file PDF così come caricato, per consultazione.
  importata            Boolean @default(false)
  pdfOriginale         Bytes?
  pdfOriginaleNomeFile String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([anno, progressivo])
  @@index([patientId])
}

// Fatture storiche caricate in attesa di revisione: il PDF viene analizzato
// automaticamente per suggerire i dati (numero, data, importo, paziente), ma
// l'utente deve sempre confermare/correggere prima che diventi una vera
// Invoice, dato che i PDF provengono da gestionali diversi con grafiche
// molto diverse tra loro e l'estrazione automatica è solo un aiuto.
model ImportazioneStaging {
  id                String    @id @default(cuid())
  nomeFileOriginale String
  pdfBytes          Bytes
  testoEstratto     String?

  suggerimentoNumero   String?
  suggerimentoData     DateTime?
  suggerimentoImporto  Decimal?  @db.Decimal(10, 2)
  suggerimentoPaziente String?

  createdAt DateTime @default(now())
}

enum StatoConservazione {
  NON_INVIATA
  IN_CORSO
  CONSERVATA
  ERRORE
}

// Impostazioni dello studio: un'unica riga (singleton) con i dati fiscali
// e i parametri per il calcolo del netto in regime forfettario.
model StudioSettings {
  id     Int    @id @default(1)
  nomeStudio             String  @default("Studio di Psicologia")
  nomePsicologa          String  @default("")
  indirizzoStudio        String  @default("")
  partitaIva             String  @default("")
  codiceFiscalePsicologa String  @default("")
  iban                   String  @default("")
  numeroAlboIscrizione   String  @default("")

  // Parametri per il calcolo del reddito netto in regime forfettario.
  // coefficienteRedditivita: quota del fatturato incassato considerata reddito imponibile
  //   (per l'attività di psicologo, codice ATECO 86.90.30, il coefficiente standard e' 0.78)
  // aliquotaImposta: aliquota dell'imposta sostitutiva (15% ordinaria, 5% per i primi 5 anni
  //   in presenza dei requisiti "start-up")
  // aliquotaContributi: aliquota dei contributi previdenziali (es. Cassa ENPAP) calcolata
  //   sul reddito imponibile; i contributi versati sono deducibili dall'imponibile
  coefficienteRedditivita Float @default(0.78)
  aliquotaImposta         Float @default(0.15)
  aliquotaContributi      Float @default(0.0)

  // Conservazione digitale a norma (InfoCert LegalDoc). Le credenziali vere e
  // proprie (URL, chiave API) restano nelle variabili d'ambiente, non qui:
  // questi sono solo i parametri "di business" che l'utente può cambiare
  // dall'interfaccia.
  conservazioneAbilitata      Boolean @default(false)
  conservazioneClasseDocumentale String @default("ll_lg_fattu")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
